{
  "version": 2,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "../../packages/db/src/generated/client/*.node"
    },
    "api/index.js": {
      "includeFiles": "../../packages/db/src/generated/client/*.node"
    }
  }
}